{
  "name": "niwa-blog-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "blog.hendrasadewa.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets"
  },
  "services": [
    {
      "binding": "BLOG_API",
      "service": "niwa-blog-api"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://blog.hendrasadewa.com",
    "NEXT_PUBLIC_API_URL": "https://blog.api.hendrasadewa.com",
    "NEXT_PUBLIC_AUTH_API_URL": "https://auth.api.hendrasadewa.com",
    "NEXT_PUBLIC_AUTH_WEB_URL": "https://auth.hendrasadewa.com"
  }
}
