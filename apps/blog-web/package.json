{
  "name": "@niwa/blog-web",
  "version": "0.0.0",
  "private": true,
  "description": "Niwa Blog — ATProto Standard.site personal semi-micro-blogging web app and Markdown Studio",
  "keywords": [
    "blog",
    "atproto",
    "standard-site",
    "bluesky",
    "nextjs",
    "react"
  ],
  "author": "Hendra Sadewa <me@hendrasadewa.com>",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@niwa/api-client": "workspace:*",
    "@niwa/auth": "workspace:*",
    "@niwa/blog-validators": "workspace:*",
    "@niwa/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "catalog:",
    "unified": "^11.0.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "^20",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9",
    "eslint-config-next": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
