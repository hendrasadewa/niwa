{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niwa-auth-web",
  "compatibility_date": "2026-08-22",
  "routes": [
    {
      "pattern": "auth.hendrasadewa.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
