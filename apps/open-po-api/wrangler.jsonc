{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niwa-open-po-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "preorder.api.hendrasadewa.com",
      "custom_domain": true
    }
  ],
  "dev": {
    "port": 8789
  },
  "vars": {
    "AUTH_API_URL": "https://auth.api.hendrasadewa.com",
    "JWT_ISSUER": "https://auth.api.hendrasadewa.com",
    "ALLOWED_ORIGINS": "https://preorder.hendrasadewa.com"
  },
  "services": [
    {
      "binding": "AUTH_API",
      "service": "niwa-auth-api"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-po-db",
      "database_id": "e6add6f1-436c-47d6-8ff8-47573fca8064",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "open-po-media"
    }
  ]
}
