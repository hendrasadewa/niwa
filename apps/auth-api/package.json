{
  "name": "@niwa/auth-api",
  "version": "0.0.0",
  "description": "Standalone User Management, Identity & Multi-App RBAC Service",
  "keywords": [
    "niwa",
    "auth",
    "identity",
    "rbac",
    "hono",
    "cloudflare-workers"
  ],
  "license": "ISC",
  "author": "Hendra Sadewa <me@hendrasadewa.com>",
  "main": "src/index.ts",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply niwa-auth-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply niwa-auth-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@niwa/api-core": "workspace:*",
    "@niwa/auth-validators": "workspace:*",
    "@simplewebauthn/server": "^13.1.1",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
