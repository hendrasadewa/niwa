{
  "name": "@niwa/auth-api",
  "version": "0.0.0",
  "description": "Standalone User Management, Identity & Multi-App RBAC Service",
  "keywords": [
    "niwa",
    "auth",
    "identity",
    "rbac",
    "hono",
    "cloudflare-workers"
  ],
  "license": "ISC",
  "author": "Hendra Sadewa <me@hendrasadewa.com>",
  "main": "src/index.ts",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply niwa-auth-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply niwa-auth-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@niwa/auth-validators": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "jose": "^6.2.18",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.0",
    "wrangler": "^4.125.0"
  }
}
