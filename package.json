{
  "name": "niwa",
  "version": "0.0.0",
  "description": "A garden of code, collection of hendra sadewa's personal web products.",
  "keywords": ["hendrasadewa", "hendra", "sadewa", "personal-website", "blog"],
  "license": "ISC",
  "author": "Hendra Sadewa <me@hendrasadewa.com>",
  "main": "index.js",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:web": "pnpm --filter @niwa/web dev",
    "dev:api": "pnpm --filter @niwa/web-api dev",
    "dev:pustaka": "pnpm --filter @niwa/pustaka-api dev",
    "dev:pustaka-web": "pnpm --filter @niwa/pustaka-web dev",
    "dev:open-po": "pnpm --filter @niwa/open-po-api dev",
    "dev:open-po-web": "pnpm --filter @niwa/open-po-webapp dev",
    "dev:labs": "pnpm --filter @niwa/labs dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
